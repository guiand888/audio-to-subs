# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
*.egg-info/
*.egg
build/
dist/

# Installer logs
pip-log.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.pytest_cache/
coverage.xml
coverage.svg

# Type checking
.mypy_cache/

# Virtual environments
# No trailing slash on .venv: a directory-only pattern won't match a .venv
# symlink, which is exactly how one got committed and broke CI (see flake.nix).
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# pipenv
Pipfile.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific - media files (output)
*.srt
*.mp4
*.mkv
*.avi
*.mov
*.mp3
*.wav
*.flac
output/
tests/fixtures/*.mp4
tests/fixtures/*.mkv
!tests/fixtures/sample*.mp4

# Local test configuration (not committed)
test_resources.local.md

# API keys (never commit these)
.mistral_api_key
.api_key

# Local environment
.env
.env.*
!.env.example

# Project metadata (agent standards)
AGENTS.md
.agent/
CLAUDE.md

# Frontend build artefacts (each also covered by frontend/.gitignore)
frontend/node_modules/
frontend/dist/

# Local manual-test environment (podman-compose bind mounts: service
# configs, redis/db data dirs, test video fixtures)
dev/testing/
