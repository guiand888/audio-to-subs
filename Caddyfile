# Reverse proxy for ParoleSub, terminating HTTPS via automatic Let's
# Encrypt certificates.
#
# Standalone: not wired into docker-compose.yml or docker-compose.docker.yml.
# Run Caddy separately (host package/binary, or your own container) on the
# same host as the compose stack, pointed at this file, e.g.:
#   caddy run --config ./Caddyfile
#
# Requirements:
#   - Replace your-domain.example below with your real domain.
#   - DNS A/AAAA record for that domain must point at this host.
#   - Ports 80 and 443 reachable from the internet (80 is used for the ACME
#     HTTP-01 challenge and to redirect HTTP -> HTTPS; 443 for HTTPS).
#   - Only the frontend service needs to be reachable here — it already
#     reverse-proxies /api/ to the backend internally (frontend/nginx.conf).
#     backend and redis are not published to the host at all.
#   - Set BEHIND_TLS=true in your .env once this is in front, so the
#     session cookie gets the Secure flag.

your-domain.example {
	reverse_proxy localhost:8080
}
